# Runtime mode
USE_BEDROCK=false

# Optional runtime configuration
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-20250514-v1:0

# Deploy preflight
AGENTCORE_RUNTIME_NAME=ai-recruitment-runtime
AGENTCORE_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/AgentCoreExecutionRole
# Optional CDK stack name for diagnostics
AGENTCORE_CDK_STACK_NAME=CDKToolkit
